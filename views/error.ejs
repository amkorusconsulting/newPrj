<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>КОРУС Крупные сделки — Ошибка <%= status %></title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;900&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif; background: #f2f2f2; min-height: 100vh; display: flex; flex-direction: column; }
        .header { background: #121239; color: #fff; padding: 16px 32px; display: flex; justify-content: space-between; align-items: center; }
        .header h1 { font-size: 16px; font-weight: 700; letter-spacing: 0.3px; display: flex; align-items: baseline; gap: 8px; }
        .header h1 .brand-k { color: #F9423A; }
        .header h1 .brand-sub { font-weight: 600; font-size: 14px; color: rgba(255,255,255,0.55); }
        .error-container {
            flex: 1; display: flex; align-items: center; justify-content: center; padding: 40px 24px;
        }
        .error-card {
            background: #fff; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            padding: 48px; text-align: center; max-width: 480px; width: 100%;
        }
        .error-code {
            font-size: 72px; font-weight: 900; color: #F9423A; line-height: 1;
        }
        .error-title {
            font-size: 20px; font-weight: 700; color: #121239; margin-top: 12px;
        }
        .error-message {
            font-size: 14px; color: #666; margin-top: 12px; line-height: 1.6;
        }
        .error-actions { margin-top: 28px; }
        .btn {
            display: inline-block; padding: 10px 24px; border-radius: 6px;
            font-size: 14px; font-weight: 500; text-decoration: none; cursor: pointer;
        }
        .btn-primary { background: #002FA7; color: #fff; }
        .btn-primary:hover { background: #0038c7; }
        .btn-outline { background: #fff; color: #666; border: 1px solid #ddd; margin-left: 8px; }
        .btn-outline:hover { background: #f5f5f5; }
        @media (max-width: 500px) {
            .error-code { font-size: 56px; }
            .error-card { padding: 32px 24px; }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1><span class="brand-name"><span class="brand-k">К</span>ОРУС</span> <span class="brand-sub">Крупные сделки</span></h1>
    </div>
    <div class="error-container">
        <div class="error-card">
            <div class="error-code"><%= status %></div>
            <div class="error-title"><%= title %></div>
            <div class="error-message"><%= message %></div>
            <div class="error-actions">
                <a href="/dashboard" class="btn btn-primary">На главную</a>
                <a href="javascript:history.back()" class="btn btn-outline">Назад</a>
            </div>
        </div>
    </div>
</body>
</html>
