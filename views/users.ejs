<!DOCTYPE html>
<html lang="ru">
<head>
    <title>КОРУС Крупные сделки — Пользователи</title>
    <%- include('partials/head') %>
    <style>
        .alert { padding: 12px 16px; border-radius: 8px; font-size: 14px; margin-bottom: 20px; }
        .alert-error { background: #fee; color: #c33; }
        .alert-success { background: #efe; color: #2a7a2a; }
        .card h2 { font-size: 16px; color: #333; margin-bottom: 16px; }
        .form-row { display: flex; gap: 12px; flex-wrap: wrap; align-items: flex-end; }
        .form-group { display: flex; flex-direction: column; gap: 4px; }
        .form-group label { font-size: 13px; color: #666; font-weight: 500; }
        .form-group input { padding: 8px 12px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px; outline: none; }
        .form-group input:focus { border-color: #002FA7; }
        .checkbox-group { display: flex; align-items: center; gap: 6px; padding-bottom: 4px; }
        .checkbox-group label { font-size: 13px; color: #666; }
        .btn-success { background: #2e7d32; color: #fff; }
        .btn-success:hover { background: #388e3c; }
        .btn-warning { background: #e65100; color: #fff; }
        .btn-warning:hover { background: #ef6c00; }
        table { width: 100%; border-collapse: collapse; }
        th { text-align: left; padding: 10px 16px; font-size: 13px; color: #666; font-weight: 600; border-bottom: 1px solid #eee; }
        td { padding: 10px 16px; font-size: 14px; color: #333; border-bottom: 1px solid #f0f0f0; }
        tr:hover { background: #f9fbfd; }
        .tag { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; }
        .tag-admin { background: #e0e7ff; color: #002FA7; }
        .tag-approver { background: #e8f5e9; color: #2e7d32; }
        .tag-inactive { background: #fce4ec; color: #c62828; }
        .actions { display: flex; gap: 6px; }
        .actions form { display: inline; }
        .pwd-form { display: none; margin-top: 6px; }
        .pwd-form.open { display: flex; gap: 4px; }
        .pwd-form input { padding: 4px 8px; border: 1px solid #ddd; border-radius: 4px; font-size: 12px; width: 140px; }
        @media (max-width: 768px) {
            .form-row { flex-direction: column; gap: 12px; }
            .form-row .form-group { width: 100%; }
            .checkbox-group { padding-bottom: 0; }
            .actions { flex-wrap: wrap; }
            table, thead, tbody, th, td, tr { display: block; }
            thead { display: none; }
            tr { padding: 12px 0; border-bottom: 1px solid #eee; }
            td { padding: 4px 0; border: none; display: flex; justify-content: space-between; align-items: center; }
            td::before { font-weight: 600; color: #888; font-size: 12px; }
            td:nth-child(1)::before { content: 'Имя'; }
            td:nth-child(2)::before { content: 'Email'; }
            td:nth-child(3)::before { content: 'Роли'; }
            td:nth-child(4)::before { content: 'Статус'; }
            td:nth-child(5) { flex-direction: column; align-items: flex-start; gap: 6px; }
            td:nth-child(5)::before { content: 'Действия'; }
            .pwd-form input { width: 100%; }
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>
    <%- include('partials/nav', { activePage: 'users' }) %>

    <div class="container">
        <% if (error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>
        <% if (success) { %>
            <div class="alert alert-success"><%= success %></div>
        <% } %>

        <div class="card">
            <h2>Новый пользователь</h2>
            <form method="POST" action="/users">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-row">
                    <div class="form-group">
                        <label>Имя</label>
                        <input type="text" name="name" required placeholder="Иванов Иван">
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" name="email" required placeholder="user@company.com">
                    </div>
                    <div class="form-group">
                        <label>Пароль</label>
                        <input type="password" name="password" required minlength="6" placeholder="Минимум 6 символов">
                    </div>
                    <div class="checkbox-group">
                        <input type="checkbox" name="is_admin" id="is_admin">
                        <label for="is_admin">Админ</label>
                    </div>
                    <button type="submit" class="btn btn-primary">Создать</button>
                </div>
            </form>
        </div>

        <div class="card">
            <h2>Пользователи (<%= users.length %>)</h2>
            <table>
                <thead>
                    <tr>
                        <th>Имя</th>
                        <th>Email</th>
                        <th>Роли</th>
                        <th>Статус</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(u => { %>
                        <tr>
                            <td><%= u.name %></td>
                            <td><%= u.email %></td>
                            <td>
                                <% if (u.is_admin) { %><span class="tag tag-admin">Админ</span><% } %>
                                <% if (u.is_permanent_approver) { %><span class="tag tag-approver">Согласующий</span><% } %>
                            </td>
                            <td>
                                <% if (u.is_active) { %>Активен<% } else { %><span class="tag tag-inactive">Отключён</span><% } %>
                            </td>
                            <td>
                                <div class="actions">
                                    <% if (u.id !== user.id) { %>
                                        <form method="POST" action="/users/<%= u.id %>/toggle">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button class="btn btn-sm <%= u.is_active ? 'btn-warning' : 'btn-success' %>">
                                                <%= u.is_active ? 'Отключить' : 'Включить' %>
                                            </button>
                                        </form>
                                    <% } %>
                                    <% if (!u.is_permanent_approver) { %>
                                        <form method="POST" action="/users/<%= u.id %>/approver/add">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button class="btn btn-sm btn-outline">+ Согласующий</button>
                                        </form>
                                    <% } else { %>
                                        <form method="POST" action="/users/<%= u.id %>/approver/remove">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button class="btn btn-sm btn-danger">- Согласующий</button>
                                        </form>
                                    <% } %>
                                    <button class="btn btn-sm btn-outline" onclick="togglePwd(<%= u.id %>)">Пароль</button>
                                </div>
                                <div class="pwd-form" id="pwd-<%= u.id %>">
                                    <form method="POST" action="/users/<%= u.id %>/password" style="display:flex; gap:4px;">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="password" name="password" minlength="6" required placeholder="Новый пароль">
                                        <button class="btn btn-sm btn-primary">OK</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <script>
        function togglePwd(id) {
            var el = document.getElementById('pwd-' + id);
            el.classList.toggle('open');
            if (el.classList.contains('open')) el.querySelector('input').focus();
        }
    </script>
</body>
</html>
