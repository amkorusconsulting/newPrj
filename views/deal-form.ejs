<!DOCTYPE html>
<html lang="ru">
<head>
    <title>КОРУС Крупные сделки — <%= deal ? 'Редактирование сделки' : 'Новая сделка' %></title>
    <%- include('partials/head') %>
    <style>
        .container { max-width: 700px; }
        .card h2 { font-size: 18px; color: #333; margin-bottom: 24px; }
        .form-group { margin-bottom: 20px; }
        .form-group label { display: block; font-size: 14px; color: #555; margin-bottom: 6px; font-weight: 500; }
        .form-group input, .form-group select, .form-group textarea {
            width: 100%; padding: 10px 14px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px; outline: none; font-family: inherit;
        }
        .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: #002FA7; }
        .form-group textarea { resize: vertical; min-height: 80px; }
        .form-row { display: flex; gap: 16px; }
        .form-row .form-group { flex: 1; }
        .alert-error { background: #fee; color: #c33; padding: 12px 16px; border-radius: 8px; font-size: 14px; margin-bottom: 20px; }
        .btn-row { display: flex; gap: 12px; margin-top: 8px; }
        .card { padding: 32px; }
        @media (max-width: 768px) {
            .card { padding: 20px; }
            .form-row { flex-direction: column; gap: 16px; }
            .form-row .form-group { flex: none; width: 100%; }
            .btn-row { flex-direction: column; }
            .btn-row .btn { text-align: center; }
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>
    <%- include('partials/nav', { activePage: 'deals' }) %>

    <div class="container">
        <% if (error) { %>
            <div class="alert-error"><%= error %></div>
        <% } %>

        <div class="card">
            <h2><%= deal ? 'Редактирование сделки #' + deal.id : 'Новая сделка' %></h2>

            <form method="POST" action="<%= deal ? '/deals/' + deal.id + '/edit' : '/deals' %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group">
                    <label>Клиент</label>
                    <input type="text" name="client" required value="<%= deal ? deal.client : '' %>">
                </div>

                <div class="form-group">
                    <label>Подразделение</label>
                    <input type="text" name="department" required value="<%= deal ? deal.department : '' %>">
                </div>

                <div class="form-group">
                    <label>Предмет сделки</label>
                    <textarea name="subject" required><%= deal ? deal.subject : '' %></textarea>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Сумма</label>
                        <input type="number" name="amount" step="0.01" value="<%= deal && deal.amount ? deal.amount : '' %>">
                    </div>
                    <div class="form-group">
                        <label>Крайний срок (дата)</label>
                        <input type="date" name="deadline_date"
                               value="<%= deal && deal.deadline ? new Date(deal.deadline).toISOString().slice(0, 10) : '' %>">
                    </div>
                    <div class="form-group">
                        <label>Время (необязательно)</label>
                        <input type="time" name="deadline_time" placeholder="23:59"
                               value="<%= deal && deal.deadline ? new Date(deal.deadline).toISOString().slice(11, 16) : '' %>">
                    </div>
                </div>

                <div class="form-group">
                    <label>Инициатор</label>
                    <select name="initiator_id" required>
                        <option value="">— Выберите —</option>
                        <% users.forEach(u => { %>
                            <option value="<%= u.id %>" <%= deal && deal.initiator_id === u.id ? 'selected' : '' %>>
                                <%= u.name %> (<%= u.email %>)
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="btn-row">
                    <button type="submit" class="btn btn-primary"><%= deal ? 'Сохранить' : 'Создать сделку' %></button>
                    <a href="<%= deal ? '/deals/' + deal.id : '/dashboard' %>" class="btn btn-outline">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
